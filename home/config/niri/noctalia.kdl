layout {

    focus-ring {
        active-color   "#d8d6f1"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d8d6f1"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d8d6f1"
        inactive-color "#bcbad5"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d8d6f180"
    }
}

recent-windows {
    highlight {
        active-color "#d8d6f1"
        urgent-color "#ffb4ab"
    }
}
